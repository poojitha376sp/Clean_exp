  "artifact": "/* Finite State Machine (FSM) representation for the embedded controller requirements */\n\n/* States */\nState Idle;\nState Inspiration;\nState Expiration;\nState Measurement;\n\n/* Events */\nEvent TriggerInspiration;\nEvent TriggerExpiration;\nEvent MeasurePEEP;\nEvent PressureBelowThreshold;\nEvent PressureAboveThreshold;\nEvent BreathRateExceeded;\n\n/* Transitions with guards */\nTransition Idle --> Inspiration\n    Guard: TriggerInspiration\n    Action: InitiateInspirationCycle;\n\nTransition Inspiration --> Expiration\n    Guard: InspirationCycleComplete\n    Action: EndInspirationCycle;\n\nTransition Expiration --> Idle\n    Guard: ExpirationCycleComplete\n    Action: PrepareNextCycle;\n\nTransition Idle --> Measurement\n    Guard: MeasurePEEPRequested\n    Action: StartPEEPMeasurement;\n\nTransition Measurement --> Idle\n    Guard: PEEPMeasured\n    Action: RecordPEEPValue;\n\n/* Additional guards for pressure limits */\nGuard PressureBelowThresholdGuard\n    Condition: MeasuredPressure < -4cm;\nGuard PressureAboveThresholdGuard\n    Condition: MeasuredPressure > 60cm;\n\n/* Lifecycle */\nInitialState: Idle;\n\n/* Requirements mapping */\n[RW-SW-4] => PressureBelowThresholdGuard;\n[RW-SW-7] => PressureAboveThresholdGuard;\n[RW-SW-52] => MeasurePEEP;\n[RW-SW-55] => Within10PercentTargetGuard;\n[RW-SW-56] => TriggerInspiration;\n[RW-SW-57] => TriggerExpiration;\n[RW-SW-59] => PIPTargetGuard;\n[RW-SW-62] => BreathRateTargetGuard;",
