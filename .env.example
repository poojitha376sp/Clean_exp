# Copy this file to  ../.env  (the folder ABOVE the repository, NOT inside it) and fill in what you need.
# The real .env is git-ignored; never commit it. Every value below is a placeholder.

# --- Local or remote Ollama ------------------------------------------------------------------
# Nothing is needed here if you run Ollama on the same machine:
#   export OLLAMA_BASE_URL=http://localhost:11434
# (or edit providers.ollama.base_url in config.yaml).

# --- Optional: SSH-tunnelled GPU server (tools/server/*) -------------------------------------
GPU_USER=your-ssh-user
GPU_HOST=gpu-server.example.org
# Recommended: key-based login. Absolute path to a private key.
GPU_SSH_KEY=~/.ssh/id_ed25519
# Optional fallback if you cannot use a key; leave empty otherwise.
GPU_PASS=

# --- Optional: hosted providers, only for the smoke tests in config.yaml -----------------------
LLM2_API_KEY=            # Groq
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# DEEPSEEK_API_KEY=
