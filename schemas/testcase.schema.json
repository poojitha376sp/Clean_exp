{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical test case (representation-independent)",
  "type": "object",
  "required": ["id", "title", "req_ids", "kind", "preconditions", "steps", "expected"],
  "properties": {
    "id": {"type": "string", "pattern": "^TC-[A-Za-z0-9_.-]+$"},
    "title": {"type": "string", "minLength": 5},
    "req_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "kind": {"enum": ["positive", "negative", "boundary"]},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "inputs": {"type": "object"},
    "steps": {"type": "array", "items": {"type": "string", "minLength": 3}, "minItems": 1},
    "expected": {"type": "array", "items": {"type": "string", "minLength": 3}, "minItems": 1}
  },
  "additionalProperties": true
}
