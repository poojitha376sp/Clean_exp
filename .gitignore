# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables
.env
.env.*
!.env.example

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# PowerPoint lock files / Windows alternate-data-stream artifacts
~$*.pptx
*:Zone.Identifier

# LLM response cache (regenerable)
.cache/

# Execution scratch space (throwaway copies of the subject code + venv,
# recreated every S6 run; the actual result data is in runs/<project>/*.json)
runs/*/S6_workspace_gated/
runs/*/S6_pyenv/
runs/gemini_smoke/

# macOS / Linux
.DS_Store
Thumbs.db
